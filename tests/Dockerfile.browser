FROM python:3.12-slim-bookworm
RUN pip install --no-cache-dir playwright==1.51.0 && playwright install --with-deps chromium && apt-get update && apt-get install -y fonts-noto-cjk && rm -rf /var/lib/apt/lists/*
WORKDIR /test
COPY tests/browser_smoke.py tests/browser_restart_smoke.py ./
CMD ["python", "browser_smoke.py"]
