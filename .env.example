POSTGRES_PASSWORD=replace-with-long-random-password
SESSION_SECRET=replace-with-at-least-32-random-characters
FINNHUB_API_KEY=
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
COOKIE_SECURE=false
QUOTE_TTL=15
MAX_QUOTE_AGE=900
US_MAX_QUOTE_AGE=1800
MARKET_CALLS_PER_MINUTE=50

# KIS quotations (Korean stocks; US extended-hours and day-market prices).
# No account number required.
KIS_APP_KEY=
KIS_APP_SECRET=

# Weekly website report (Asia/Seoul): Monday=0, Saturday=5
WEEKLY_ENABLED=true
WEEKLY_DAY=5
WEEKLY_HOUR=9

# Daily performance snapshots for research (Asia/Seoul). 07:00 is after the US
# regular close in summer and winter while Korea is closed. A day that cannot
# be completed within the retry window is left as a gap, never back-filled.
# KR:069500 (KODEX 200) stands in for the KOSPI 200 index.
DAILY_SNAPSHOT_ENABLED=true
DAILY_SNAPSHOT_HOUR=7
DAILY_SNAPSHOT_RETRY_MINUTES=120
DAILY_SNAPSHOT_MAX_QUOTE_AGE_DAYS=7
BENCHMARK_SYMBOLS=SPY,QQQ,KR:069500

# Multi-currency and provider settings
KOREA_MARKET_PROVIDER=kis
KOREA_MARKET_API_KEY=
KOREA_MARKET_API_SECRET=
ALPHAVANTAGE_API_KEY=
INITIAL_USD=100000
FX_FEE_BPS=10
FX_SPREAD_BPS=5
US_BUY_FEE_BPS=0
US_SELL_FEE_BPS=0
KR_BUY_FEE_BPS=0
KR_SELL_FEE_BPS=0
KR_SELL_TAX_BPS=0

# HTTPS deployment (not enabled by the LAN compose file)
DOMAIN=
LETSENCRYPT_EMAIL=
PUBLIC_HTTP_PORT=80
HTTPS_PORT=443

# Same-currency paper wallet transfer fee: 10 bps = 0.10%
TRANSFER_FEE_BPS=10

# Opt-in after isolated SSE verification; false restores detail REST polling.
QUOTE_SSE_ENABLED=false
QUOTE_SSE_HEARTBEAT=15
QUOTE_SSE_USER_LIMIT=5
QUOTE_SSE_IP_LIMIT=30

# Trade stream (one KIS WebSocket in the market-stream service, shared by US
# and Korean trades).
# US_/KR_STREAM_MAX_AGE: seconds since the stream worker's last heartbeat for a
#   stream price to count as realtime. A quiet symbol's last trade stays valid
#   while the connection is healthy; after that it is judged like REST
#   (US_MAX_QUOTE_AGE / MAX_QUOTE_AGE).
# MARKET_STREAM_MAX_SUBSCRIPTIONS: KIS registrations per session across both
#   markets (3 verified for the current key; a KIS refusal lowers it at runtime).
US_TRADE_STREAM_ENABLED=true
KR_TRADE_STREAM_ENABLED=true
US_STREAM_MAX_AGE=10
KR_STREAM_MAX_AGE=10
MARKET_STREAM_MAX_SUBSCRIPTIONS=3
MARKET_STREAM_RECONNECT_MAX_SECONDS=60
